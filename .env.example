# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unfold_db?schema=public"

# Authentication & Admin Access Control
AUTH_SECRET="your-jwt-auth-secret-32-chars-minimum"
ADMIN_EMAIL="admin@unfold.store"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_SESSION_SECRET="your-cryptographically-random-session-secret"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloud Image Storage (Cloudinary / AWS S3 / Cloudflare R2)
IMAGE_STORAGE_URL=""
IMAGE_STORAGE_KEY=""
IMAGE_STORAGE_SECRET=""

# Payment Gateway (Razorpay / Stripe)
PAYMENT_SECRET_KEY=""
NEXT_PUBLIC_PAYMENT_KEY=""

# Email Service (Resend / SendGrid)
EMAIL_SERVER=""
EMAIL_FROM="UNFOLD <orders@unfold.store>"
